# Example environment variables for GoDelivery
# Copy this file to `.env` and fill in real values locally (do NOT commit)

# PostgreSQL connection string (e.g. postgresql://user:pass@host:port/dbname)
DATABASE_URL=

# JWT signing secret (use a long, random string in production)
JWT_SECRET=

# Server port
PORT=3000

# Node environment (development|production)
NODE_ENV=development

# Super admin seed credentials (optional for development)
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_EMAIL=

# Password reset emails (optional). If unset, reset links are logged to the
# server console instead of being emailed — useful for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Public base URL used to build password reset links and the /sitemap.xml URLs
# (optional, defaults to request host)
APP_URL=

# Transactional WhatsApp/SMS. External delivery is disabled unless the server
# runs in production with COMMUNICATION_ENABLED=true and a channel is enabled.
# Set COMMUNICATION_DRY_RUN=true for a local, no-provider preview.
COMMUNICATION_ENABLED=false
COMMUNICATION_DRY_RUN=false
WHATSAPP_ENABLED=false
SMS_ENABLED=false
CUSTOMER_TRANSACTIONAL_MESSAGES_ENABLED=false
COMMUNICATION_PRIMARY_CHANNEL=whatsapp
COMMUNICATION_TIMEOUT_MS=5000
# Optional country code for legacy local numbers; international numbers remain unchanged.
DEFAULT_PHONE_COUNTRY_CODE=

# Twilio is the single provider adapter for both channels. Leave blank until configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Twilio Content SID for the approved WhatsApp template described in docs/communication-architecture.md.
TWILIO_WHATSAPP_CONTENT_SID=
