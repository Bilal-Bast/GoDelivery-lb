# Example environment variables for GoDelivery
# Copy this file to `.env` and fill in real values locally (do NOT commit)

# PostgreSQL connection string (e.g. postgresql://user:pass@host:port/dbname)
DATABASE_URL=

# JWT signing secret (use a long, random string in production)
JWT_SECRET=

# Server port
PORT=3000

# Node environment (development|production)
NODE_ENV=development

# Super admin seed credentials (optional for development)
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_EMAIL=

# Password reset emails (optional). If unset, reset links are logged to the
# server console instead of being emailed — useful for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Public base URL used to build password reset links and the /sitemap.xml URLs
# (optional, defaults to request host)
APP_URL=
