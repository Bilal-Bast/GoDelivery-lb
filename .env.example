# Example environment variables for GoDelivery
# Copy this file to `.env` and fill in real values locally (do NOT commit)

# MongoDB connection string (e.g. mongodb://user:pass@host:port/db)
MONGO_URL=

# JWT signing secret (use a long, random string in production)
JWT_SECRET=

# Server port
PORT=3000

# Node environment (development|production)
NODE_ENV=development
# Copy this file to `.env` and fill the values before running the app

# MongoDB connection string. Example: mongodb://user:pass@host:port/dbname
MONGO_URL=

# JWT secret used to sign tokens (keep this secret in production)
JWT_SECRET=

# Application port (optional, defaults to 3000)
PORT=3000

# Super admin seed credentials (optional for development)
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
SUPER_ADMIN_PHONE=

# Environment
NODE_ENV=development
