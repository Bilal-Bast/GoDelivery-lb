extends layout

block head
	link(href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet")
	link(rel="stylesheet" href="/css/admin.css")
	link(rel="stylesheet" href="/css/collect.css")
	link(rel="shortcut icon" href="/assets/logogo-removebg-preview.png" type="image/x-icon")

block content
	include components/nav/admin-nav.pug
	include components/nav/admin-sidebar.pug

	main.main-content
		div.finance-page
			div.page-header
				h1
					i.bx.bx-wallet(style="color:#3b82f6")
					|  Collect Money from Drivers
				p Record cash collected from drivers after deliveries.

			if success
				div.toast.success Collection completed successfully.
			if error
				div.toast.error= error

			div.card
				h2
					i.bx.bx-plus-circle(style="color:#3b82f6")
					|  Add Collection
				form(method="get" action="/collect")
					div.form-grid
						div.form-field.full
							label Driver *
							select#driverSelect(name="driver" required onchange="this.form.submit()")
								option(value="") Select Driver
								- const drivers = pageData && pageData.drivers ? pageData.drivers : [];
								each driver in drivers
									option(value=driver.id selected=(selectedDriver === driver.id))= driver.name || driver.id
						button.submit-btn(type="submit") Load Orders

			div.card
				h2
					i.bx.bx-package(style="color:#3b82f6")
					|  Driver Orders
				form#collectForm(method="post" action="/collect")
					input(type="hidden" name="driverUsername" value=selectedDriver)
					div.table-wrapper
						table
							thead
								tr
									th
										input#selectAllOrders(type="checkbox")
									th Order ID
									th Customer
									th Total ($)
									th Status
							tbody#ordersBody
								- const orders = pageData && pageData.orders ? pageData.orders : [];
								if selectedDriver && orders.length
									each order in orders
										tr
											td
												input(type="checkbox" name="orderIds" value=order.id onchange="updateSelectedTotal()")
											td= order.id
												td= ((order.c && order.c.f) ? order.c.f : '-') + ' ' + ((order.c && order.c.l) ? order.c.l : '')
												td.amount-cell= (order.pr && order.pr.t) ? order.pr.t : 0
											td= order.s === 3 ? 'Delivered' : 'Cancelled'
									else
										tr
											td(colspan="5" class="empty-msg") Select a driver to view orders

					div.orders-footer
						div.orders-total
							| Total Selected: 
							span#selectedTotal $0.00
						button.submit-btn#confirmBtn(type="submit")
							i.bx.bx-check
							|  Confirm Collection

			div.card
				h2
					i.bx.bx-list-ul(style="color:#3b82f6")
					|  Collections History
				div.table-wrapper
					table#collectionsTable
						thead
							tr
								th #
								th Driver
								th Created By
								th Amount
								th Date
						tbody#collectionsBody
							- const collections = pageData && pageData.collections ? pageData.collections : [];
							if collections.length
								each collection in collections
									tr
										td= collection.number
										td= collection.driverName || collection.driverUsername
										td= collection.adminUsername
										td.amount-cell= '$' + Number(collection.amount).toFixed(2)
										td= new Date(collection.createdAt).toLocaleDateString()
								tr.total-row
									td(colspan="2" style="text-align:right;") Total
									td.amount-cell= '$' + (collections.reduce((sum, item) => sum + Number(item.amount || 0), 0)).toFixed(2)
									td(colspan="2")
							else
								tr
									td(colspan="5" class="empty-msg") No collections recorded yet.

		script.
			window.__SELECTED_DRIVER__ = !{JSON.stringify(selectedDriver || '')};
	script(src="/js/admin.js")
	script(src="/js/collect.js")
