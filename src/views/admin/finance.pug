extends ../layout

block head
	link(href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet")
	link(rel="shortcut icon" href="/assets/logogo-removebg-preview.png" type="image/x-icon")
	link(rel="stylesheet" href="/css/admin.css")
	link(rel="stylesheet" href="/css/finance.css")
	script(src="https://cdn.jsdelivr.net/npm/chart.js")

block content
	include ../components/nav/admin-nav.pug
	include ../components/nav/admin-sidebar.pug
	main.main-content
		div.container.finance-page
			h1.finance-title Finance Center
			p.finance-subtitle Central hub for collections, settlements, expenses, transactions, and reporting.

			section.finance-overview
				h2.section-title Financial Overview

				each group, groupName in financeData.stats
					if groupName !== "alerts"
						div.finance-group
							h3.group-title= groupName

							div.stats-grid
								each stat in group
									div.stat-card(class=stat.key)
										div.stat-icon
											i(class="bx " + stat.icon)
										div.stat-content
											div.stat-title= stat.title
											div.stat-value= stat.value
											div.stat-meta= stat.description
											div.stat-trend= stat.trend

			section.quick-actions
				h2.section-title Quick Actions
				div.actions-grid
					button.action-btn(data-action="cash-in") Cash In
					button.action-btn(data-action="cash-out") Cash Out
					button.action-btn(data-action="driver-collect") Receive Driver Cash
					button.action-btn(data-action="merchant-pay") Pay Merchant
					button.action-btn(data-action="expense") Add Expense
					button.action-btn(data-action="report") Generate Report

			section.balances-panel
				h2.section-title Balances Overview

				div.balance-totals
					div.balance-total-card.owed-out
						div.balance-total-label We Owe Merchants
						div.balance-total-value#totalOwedToMerchants $0
					div.balance-total-card.owed-in
						div.balance-total-label Merchants Owe Us
						div.balance-total-value#totalOwedByMerchants $0
					div.balance-total-card.owed-in
						div.balance-total-label Drivers Owe Us
						div.balance-total-value#totalOwedByDrivers $0

				h3.subsection-title Merchants
				div.table-scroll
					table.finance-table#merchantBalancesTable
						thead
							tr
								th Merchant
								th Type
								th Orders
								th Entitled
								th Paid
								th Balance
						tbody

				h3.subsection-title Drivers
				div.table-scroll
					table.finance-table#driverBalancesTable
						thead
							tr
								th Driver
								th Orders
								th Gross Cash
								th Driver Fee
								th Outstanding
						tbody

			section.prepaid-panel
				h2.section-title Pay Prepaid Merchant

				div.prepaid-form
					div.prepaid-field
						label.prepaid-label(for="prepaidMerchantSelect") Merchant
						select#prepaidMerchantSelect.prepaid-input
							option(value="") Select a prepaid merchant

					div#prepaidBalanceBox.prepaid-balance.hidden
						div.prepaid-balance-row
							span Orders value
							strong#prepaidOrdersValue $0
						div.prepaid-balance-row
							span Legacy balance (old system)
							strong#prepaidLegacyBalance $0
						div.prepaid-balance-row
							span Entitled total
							strong#prepaidEntitled $0
						div.prepaid-balance-row
							span Already paid
							strong#prepaidPaid $0
						div.prepaid-balance-row.prepaid-balance-net
							span Outstanding balance
							strong#prepaidBalance $0
						div.prepaid-balance-hint#prepaidBalanceHint

					div.prepaid-field
						label.prepaid-label(for="prepaidAmount") Amount ($) — negative to collect from merchant
						input#prepaidAmount.prepaid-input(type="number" step="0.01" placeholder="0.00")

					div.prepaid-field
						label.prepaid-label(for="prepaidNotes") Note (optional)
						input#prepaidNotes.prepaid-input(type="text" placeholder="e.g. partial advance")

					div.prepaid-actions
						button.action-btn#prepaidPayBtn(type="button" disabled) Pay Merchant
					div#prepaidMessage.prepaid-message

					div#prepaidLegacyBox.prepaid-legacy-panel.hidden
						h4.prepaid-legacy-title Debt from old system
						div.prepaid-field
							label.prepaid-label(for="prepaidLegacyInput") Legacy balance ($)
							input#prepaidLegacyInput.prepaid-input(type="number" step="0.01" placeholder="0.00")
						div.prepaid-actions
							button.action-btn.secondary-btn#prepaidLegacySaveBtn(type="button") Save Legacy Balance
						div#prepaidLegacyMessage.prepaid-message

				h3.subsection-title Advance Payment History
				div.table-scroll
					table.finance-table#prepaidHistoryTable
						thead
							tr
								th #
								th Date
								th Amount
								th Note
								th Recorded By
								th Actions
						tbody
							tr
								td(colspan="6" class="empty-cell") Select a prepaid merchant to see their payment history

			section.alerts-panel
				h2.section-title Alerts
				div.alert-list
					each alert in financeData.stats.alerts || []
						div.alert-item(class=alert.type)
							strong= alert.title
							span= alert.detail

			section.chart-grid
				div.chart-card
					h3 Revenue Over Time
					canvas#revenueChart
				div.chart-card
					h3 Cash Flow
					canvas#cashFlowChart
				div.chart-card
					h3 Expense Categories
					canvas#expenseChart

			section.table-panel
				h2.section-title Awaiting Driver Collection
				table.finance-table#driverCollectionsTable
					thead
						tr
							th Driver
							th Delivered Orders
							th Collected Orders
							th Outstanding Cash
							th Last Collection
							th Actions
					tbody
						

			section.table-panel
				h2.section-title Awaiting Merchant Payment
				table.finance-table#merchantPaymentsTable
					thead
						tr
							th Merchant
							th Collected Orders
							th Amount Owed
							th Last Payment
							th Actions
					tbody
						

			section.table-panel
				.collapsible-header(id="transactionsHeader")
					h2.section-title Transactions
					i.bx.bx-chevron-down.collapsible-icon(id="transactionsIcon")
				table.finance-table.collapsible-content(id="transactionsTable" style="display: none;")
					thead
						tr
							th Date
							th Type
							th Amount
							th Method
							th Status
							th Related Order
							th Driver
							th Merchant
							th Admin
					tbody
						each transaction in financeData.transactions
							tr
								td= new Date(transaction.date).toLocaleDateString()
								td= transaction.type
								td= transaction.amount
								td= transaction.paymentMethod
								td= transaction.status
								td= transaction.relatedOrder || '—'
								td= transaction.driver || '—'
								td= transaction.merchant || '—'
								td= transaction.adminUsername || '—'

			section.table-panel
				.collapsible-header(id="expensesHeader")
					h2.section-title Expenses
					i.bx.bx-chevron-down.collapsible-icon(id="expensesIcon")
				table.finance-table.collapsible-content(id="expensesTable" style="display: none;")
					thead
						tr
							th Date
							th Category
							th Amount
							th Description
							th Created By
					tbody
						each expense in financeData.expenses
							tr
								td= new Date(expense.date).toLocaleDateString()
								td= expense.category
								td= expense.amount
								td= expense.description || '—'
								td= expense.createdBy || '—'

			section.table-panel
				.collapsible-header(id="auditLogHeader")
					h2.section-title Audit Log
					i.bx.bx-chevron-down.collapsible-icon(id="auditLogIcon")
				table.finance-table.collapsible-content(id="auditLogTable" style="display: none;")
					thead
						tr
							th Date
							th User
							th Action
							th Description
					tbody
						each audit in financeData.audits
							tr
								td= new Date(audit.date).toLocaleDateString()
								td= audit.user
								td= audit.action
								td= audit.description

	div.finance-modal.hidden(id="financeModal")
		.div.finance-modal-overlay
		.div.finance-modal-window
			.div.modal-header
				h2#modalTitle Finance
				button#closeModal(type="button")
					i.bx.bx-x
			form#financeForm
				div#modalBody
				.div.modal-footer
					button.cancel-btn(type="button") Cancel
					button.save-btn(type="submit") Save							

	script.
		window.__INIT_DATA__ = !{initData || '{}'};
		window.__CURRENT_USER__ = !{JSON.stringify(currentUser || null)};
	script(src="/js/admin.js")
	script(src="/js/finance.js")
