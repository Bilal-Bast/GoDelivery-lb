extends ../layout

block head
	link(href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet")
	link(rel="stylesheet" href="/css/admin.css")
	link(rel="stylesheet" href="/css/settings.css")
	link(rel="shortcut icon" href="/assets/logogo-removebg-preview.png" type="image/x-icon")

block content
	include ../components/nav/admin-nav.pug
	include ../components/nav/admin-sidebar.pug

	main.main-content
		section.section
			h1.heads Settings
			div#pageMessage.success-message(style="display:none; margin-top:10px")

			button.section-toggle-btn#addAccountToggle
				span Add New Account
				i.bx.bx-chevron-right

			div#addAccountContent.account-forms-container.hidden
				div.sub-button-group
					button.sub-toggle-btn#showAddAdminBtn
						i.bx.bx-lock-alt
						span Add Admin
					button.sub-toggle-btn#showAddMerchantBtn
						i.bx.bx-store-alt
						span Add Merchant
					button.sub-toggle-btn#showAddDriverBtn
						i.bx.bx-car
						span Add Driver

			button.section-toggle-btn#locationList
				span Add New Location
				i.bx.bx-chevron-right

			div#addLocationContent.location-form-container.hidden
				form#addLocationForm
					div.form-group
						label District
						select#districtSelect(name="district" required)
							option(value="") Select District
					div.form-group
						label City (En)
						input(type="text" name="cities" placeholder="Enter city (English)" required)
					div.form-group
						label City (Ar)
						input(type="text" name="citiesAr" placeholder="Enter city (Arabic)")
					button.submit-btn#saveLocationBtn(type="submit") Save Location

	//- ENHANCED ADMIN MODAL
	div#addAdminModal.modal-overlay.hidden
		div.modal-content
			div.modal-header
				h3.modal-title
					i.bx.bx-lock-alt
					span Add Admin Account
				button#closeAdminModal.modal-close(type="button") &times;
			form.form-enhanced
				.form-section
					h4.form-section-title Admin Credentials
					div.form-group
						label.form-label
							span Username *
							span.info-icon(title="Unique username for login")
								i.bx.bx-info-circle
						input#adminUsername.form-input(type="text" required placeholder="e.g., admin_john")
						small.field-hint Enter a unique username (any letters, numbers, or symbols)
						small#adminUsername_error.error-message

					div.form-group
						label.form-label
							span Email
							span.info-icon(title="Optional — for account recovery and notifications")
								i.bx.bx-info-circle
						input#adminEmail.form-input(type="email" placeholder="admin@example.com (optional)")
						small.field-hint Optional — used for password recovery and admin notifications
						small#adminEmail_error.error-message

					div.form-group
						label.form-label
							span Password *
							span.info-icon(title="Password required")
								i.bx.bx-info-circle
						input#adminPassword.form-input(type="password" required placeholder="Min. 6 characters")
						small.field-hint At least 6 characters
						.password-strength
							.strength-bar#adminPasswordStrength
							.strength-text#adminPasswordText
						small#adminPassword_error.error-message

				.form-section
					h4.form-section-title Personal Information
					div.form-row
						div.form-group
							label.form-label
								span First Name *
								span.info-icon(title="Admin's first name")
									i.bx.bx-info-circle
							input#adminFirstName.form-input(type="text" required placeholder="John")
							small.field-hint Full first name
							small#adminFirstName_error.error-message

						div.form-group
							label.form-label
								span Last Name
								span.info-icon(title="Admin's last name (optional)")
									i.bx.bx-info-circle
							input#adminLastName.form-input(type="text" placeholder="Doe")
							small.field-hint Last name (optional)

					div.form-group
						label.form-label
							span Phone Number *
							span.info-icon(title="Contact phone for this admin")
								i.bx.bx-info-circle
						div.phone-input-group
							div.country-selector
								div#adminCountryDisplay.country-display
									span#adminCountryFlag.emoji-flag 🇱🇧
									span#adminCountryName Lebanon
								input#adminCountrySearch.form-input.hidden-search-input(type="text" placeholder="Search...")
								div#adminCountryDropdown.dropdown-container
								input#adminCountryCode(type="hidden" value="+961")
							input#adminPhone.form-input(type="tel" placeholder="71 123 456" required)
						small.field-hint Enter phone without country code
						small#adminPhone_error.error-message

				button#addAdminBtn.btn-base.btn-admin(type="button")
					span Add Admin
					i.bx.bx-check
				p#adminMessage.success-message

	//- ENHANCED MERCHANT MODAL
	div#addMerchantModal.modal-overlay.hidden
		div.modal-content
			div.modal-header
				h3.modal-title
					i.bx.bx-store-alt
					span Add Merchant Account
				button#closeMerchantModal.modal-close(type="button") &times;
			form.form-enhanced
				.form-section
					h4.form-section-title Merchant Credentials
					div.form-row
						div.form-group
							label.form-label
								span First Name *
								span.info-icon(title="Merchant's first name")
									i.bx.bx-info-circle
							input#merchantFirstName.form-input(type="text" required placeholder="John")
							small.field-hint Merchant owner's first name
							small#merchantFirstName_error.error-message

						div.form-group
							label.form-label
								span Last Name
								span.info-icon(title="Merchant's last name (optional)")
									i.bx.bx-info-circle
							input#merchantLastName.form-input(type="text" placeholder="Doe")
							small.field-hint Last name (optional)

					div.form-group
						label.form-label
							span Phone Number *
							span.info-icon(title="Business contact number")
								i.bx.bx-info-circle
						div.phone-input-group
							div.country-selector
								div#merchantCountryDisplay.country-display
									span#merchantCountryFlag.emoji-flag 🇱🇧
									span#merchantCountryName Lebanon
								input#merchantCountrySearch.form-input.hidden-search-input(type="text" placeholder="Search...")
								div#merchantCountryDropdown.dropdown-container
								input#merchantCountryCode(type="hidden" value="+961")
							input#merchantPhone.form-input(type="tel" placeholder="71 123 456" required)
						small.field-hint Enter phone without country code
						small#merchantPhone_error.error-message

					div.form-group
						label.form-label
							span Username *
							span.info-icon(title="Unique login username")
								i.bx.bx-info-circle
						input#merchantUsername.form-input(type="text" required placeholder="e.g., merchant_store")
						small.field-hint Any letters, numbers, or symbols
						small#merchantUsername_error.error-message

					div.form-group
						label.form-label
							span Order ID Prefix
							span.info-icon(title="Optional letters prepended to this merchant's order IDs, e.g. \"ad\" + 3458 → ad3458")
								i.bx.bx-info-circle
						input#merchantOrderIdPrefix.form-input(type="text" maxlength="8" placeholder="e.g., ad (optional)")
						small.field-hint Optional — letters/numbers only, prepended to order IDs for this merchant
						small#merchantOrderIdPrefix_error.error-message

					div.form-group
						label.form-label
							span Email
							span.info-icon(title="For notifications and recovery")
								i.bx.bx-info-circle
						input#merchantEmail.form-input(type="email" placeholder="store@example.com (optional)")
						small.field-hint Optional — business email for communications
						small#merchantEmail_error.error-message

					div.form-group
						label.form-label
							span Password *
							span.info-icon(title="Password required")
								i.bx.bx-info-circle
						input#merchantPassword.form-input(type="password" required placeholder="Min. 6 characters")
						small.field-hint At least 6 characters
						.password-strength
							.strength-bar#merchantPasswordStrength
							.strength-text#merchantPasswordText
						small#merchantPassword_error.error-message

				.form-section
					h4.form-section-title Account Type & Settings
					div.account-type-group
						label.radio-label
							input#accTypePrepaid(type="radio" name="accountType" value="prepaid" checked)
							span.radio-label-text Prepaid
							span.radio-label-hint Pay upfront
						label.radio-label
							input#accTypePostpaid(type="radio" name="accountType" value="postpaid")
							span.radio-label-text Postpaid
							span.radio-label-hint Pay later (scheduled)

					div#prepaidOptions
						p.section-description Prepaid merchants are paid in advance from the Finance page — you choose how much to pay and the rest stays as a running balance. Nothing to configure here.

					div#postpaidOptions.hidden
						div.form-group
							label.form-label
								span Payment Day *
								span.info-icon(title="Day merchant gets paid (e.g., Monday)")
									i.bx.bx-info-circle
							input#merchantPaymentDay.form-input(type="text" placeholder="e.g., Monday, 15th")
							small.field-hint Day or date of payment cycle
							small#merchantPaymentDay_error.error-message

				.form-section
					h4.form-section-title Delivery Charges by Region
					p.section-description Set delivery costs for each region (0 = no delivery to that area)
					div.grid-2-col
						div.form-group
							label Akkar ($)
							input#deliveryAkkar.form-input(type="number" min="0" step="0.01" placeholder="0.00")
							small.field-hint North region delivery cost
						div.form-group
							label Baalbek-Hermel ($)
							input#deliveryBaalbek.form-input(type="number" min="0" step="0.01" placeholder="0.00")
							small.field-hint Mountain region delivery cost
					div.grid-2-col
						div.form-group
							label Beirut ($)
							input#deliveryBeirut.form-input(type="number" min="0" step="0.01" placeholder="0.00")
							small.field-hint Capital city delivery cost
						div.form-group
							label Bekaa ($)
							input#deliveryBekaa.form-input(type="number" min="0" step="0.01" placeholder="0.00")
							small.field-hint Valley region delivery cost
					div.grid-2-col
						div.form-group
							label El Nabatieh ($)
							input#deliveryNabatieh.form-input(type="number" min="0" step="0.01" placeholder="0.00")
							small.field-hint South region delivery cost
						div.form-group
							label Mount Lebanon ($)
							input#deliveryMountLebanon.form-input(type="number" min="0" step="0.01" placeholder="0.00")
							small.field-hint Mountain suburb delivery cost
					div.grid-2-col
						div.form-group
							label North ($)
							input#deliveryNorth.form-input(type="number" min="0" step="0.01" placeholder="0.00")
							small.field-hint North district delivery cost
						div.form-group
							label South ($)
							input#deliverySouth.form-input(type="number" min="0" step="0.01" placeholder="0.00")
							small.field-hint South district delivery cost

				button#addMerchantBtn.btn-base.btn-merchant(type="button")
					span Add Merchant
					i.bx.bx-check
				p#merchantMessage.success-message

	//- ENHANCED DRIVER MODAL
	div#addDriverModal.modal-overlay.hidden
		div.modal-content
			div.modal-header
				h3.modal-title
					i.bx.bx-car
					span Add Driver Account
				button#closeDriverModal.modal-close(type="button") &times;
			form.form-enhanced
				.form-section
					h4.form-section-title Driver Credentials
					div.form-row
						div.form-group
							label.form-label
								span First Name *
								span.info-icon(title="Driver's first name")
									i.bx.bx-info-circle
							input#driverFirstName.form-input(type="text" required placeholder="John")
							small.field-hint Driver's first name
							small#driverFirstName_error.error-message

						div.form-group
							label.form-label
								span Last Name
								span.info-icon(title="Driver's last name (optional)")
									i.bx.bx-info-circle
							input#driverLastName.form-input(type="text" placeholder="Doe")
							small.field-hint Last name (optional)

					div.form-group
						label.form-label
							span Phone Number *
							span.info-icon(title="Driver's contact number")
								i.bx.bx-info-circle
						div.phone-input-group
							div.country-selector
								div#driverCountryDisplay.country-display
									span#driverCountryFlag.emoji-flag 🇱🇧
									span#driverCountryName Lebanon
								input#driverCountrySearch.form-input.hidden-search-input(type="text" placeholder="Search...")
								div#driverCountryDropdown.dropdown-container
								input#driverCountryCode(type="hidden" value="+961")
							input#driverPhone.form-input(type="tel" placeholder="71 123 456" required)
						small.field-hint Enter phone without country code
						small#driverPhone_error.error-message

					div.form-group
						label.form-label
							span Username *
							span.info-icon(title="Unique login username")
								i.bx.bx-info-circle
						input#driverUsername.form-input(type="text" required placeholder="e.g., driver_john")
						small.field-hint Any letters, numbers, or symbols
						small#driverUsername_error.error-message

					div.form-group
						label.form-label
							span Email
							span.info-icon(title="For notifications")
								i.bx.bx-info-circle
						input#driverEmail.form-input(type="email" placeholder="driver@example.com (optional)")
						small.field-hint Optional — email for communications
						small#driverEmail_error.error-message

					div.form-group
						label.form-label
							span Password *
							span.info-icon(title="Password required")
								i.bx.bx-info-circle
						input#driverPassword.form-input(type="password" required placeholder="Min. 6 characters")
						small.field-hint At least 6 characters
						.password-strength
							.strength-bar#driverPasswordStrength
							.strength-text#driverPasswordText
						small#driverPassword_error.error-message

				.form-section
					h4.form-section-title Commission Settings
					div.form-group
						label.form-label
							span Delivery Fee per Order ($)
							span.info-icon(title="How much driver earns per delivery")
								i.bx.bx-info-circle
						input#driverDeliveryFee.form-input(type="number" min="0" step="any" placeholder="e.g., 2.50")
						small.field-hint Amount driver earns from each delivery (leave empty = no fixed fee)
						small#driverDeliveryFee_error.error-message

				button#addDriverBtn.btn-base.btn-admin(type="button")
					span Add Driver
					i.bx.bx-check
				p#driverMessage.success-message

	script.
		window.__INIT_DATA__ = !{initData || '{}'};
		window.__CURRENT_USER__ = !{JSON.stringify(currentUser || null)};
		window.__CSRF_TOKEN__ = !{JSON.stringify(csrfToken || null)};
	script(src="/js/admin.js")
	script(src="/js/settings.js")
