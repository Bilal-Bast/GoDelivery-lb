extends ../layout

block head
	link(href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet")
	link(rel="stylesheet" href="/css/admin.css")
	link(rel="stylesheet" href="/css/collect.css")
	link(rel="shortcut icon" href="/assets/logogo-removebg-preview.png" type="image/x-icon")

block content
	include ../components/nav/admin-nav.pug
	include ../components/nav/admin-sidebar.pug

	main.main-content
		div.finance-page
			div.page-header
				h1
					i.bx.bx-money-withdraw(style="color:#10b981")
					|  Pay Merchants
				p Record payments made to merchants for their orders.

			if success
				div.toast.success Payment completed successfully.
			if error
				div.toast.error= error

			div.card
				h2
					i.bx.bx-plus-circle(style="color:#10b981")
					|  Add Payment
				div.form-grid
					div.form-field.full
						label Merchant *
						select#merchantSelect(name="merchant" required)
							option(value="") Select Merchant
							- const merchants = pageData && pageData.merchants ? pageData.merchants : [];
							each merchant in merchants
								option(value=merchant.username selected=(selectedMerchant === merchant.username))= (merchant.firstName || '') + ' ' + (merchant.lastName || '')

			div.card
				h2
					i.bx.bx-package(style="color:#3b82f6")
					|  Merchant Orders
				form#payForm(method="post" action="/pay")
					input(type="hidden" name="_csrf" value=csrfToken)
					input#merchantUsernameInput(type="hidden" name="merchantUsername" value=selectedMerchant)
					div.table-wrapper
						table
							thead
								tr
									th
										input#selectAllOrders(type="checkbox")
									th Order ID
									th Customer
									th Total ($)
									th Status
							tbody#ordersBody
								tr
									td(colspan="5" class="empty-msg") Select a merchant to view orders

					div.orders-footer
						div.orders-total
							| Orders Selected:
							span#selectedCount 0
							span.total-divider ·
							| Total Selected:
							span#selectedTotal $0.00
						button.submit-btn#confirmBtn(type="submit")
							i.bx.bx-check
							|  Confirm Payment

			//- ✅ NEW: Payment Sessions History with Print & PDF buttons
			div.card
				h2
					i.bx.bx-history(style="color:#10b981")
					|  Payment Sessions History
				div.table-wrapper
					table#sessionsTable
						thead
							tr
								th Payment #
								th Merchant Name
								th # Orders
								th Net Amount
								th Date
								th Time
								th Actions
						tbody#sessionsBody
							tr
								td(colspan="7" class="empty-msg") No payment sessions recorded yet.

	script.
		window.__INIT_DATA__ = !{initData || '{}'};
		window.__CURRENT_USER__ = !{JSON.stringify(currentUser || null)};
		window.__SELECTED_MERCHANT__ = !{JSON.stringify(selectedMerchant || '')};
	script(src="/js/admin.js")
	script(src="/js/pay.js")
