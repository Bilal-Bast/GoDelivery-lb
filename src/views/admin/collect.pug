extends ../layout

block head
	link(href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet")
	link(rel="stylesheet" href="/css/admin.css")
	link(rel="stylesheet" href="/css/collect.css")
	link(rel="shortcut icon" href="/assets/logogo-removebg-preview.png" type="image/x-icon")

block content
	include ../components/nav/admin-nav.pug
	include ../components/nav/admin-sidebar.pug

	main.main-content
		div.finance-page
			div.page-header
				h1
					i.bx.bx-wallet(style="color:#3b82f6")
					|  Collect Money from Drivers
				p Record cash collected from drivers after deliveries.

			if success
				div.toast.success Collection completed successfully.
			if error
				div.toast.error= error

			div.card
				h2
					i.bx.bx-plus-circle(style="color:#3b82f6")
					|  Add Collection
				div.form-grid
					div.form-field.full
						label Driver *
						select#driverSelect(name="driver" required)
							option(value="") Select Driver
							- const drivers = pageData && pageData.drivers ? pageData.drivers : [];
							each driver in drivers
								option(value=driver.username selected=(selectedDriver === driver.username))= driver.name || driver.username

			div.card
				h2
					i.bx.bx-package(style="color:#3b82f6")
					|  Driver Orders
				form#collectForm(method="post" action="/collect")
					input(type="hidden" name="_csrf" value=csrfToken)
					input#driverUsernameInput(type="hidden" name="driverUsername" value=selectedDriver)
					div.table-wrapper
						table
							thead
								tr
									th
										input#selectAllOrders(type="checkbox")
									th Order ID
									th Customer
									th Total ($)
									th Status
							tbody#ordersBody
								tr
									td(colspan="5" class="empty-msg") Select a driver to view orders

					div.orders-footer
						div.orders-total
							| Total Selected:
							span#selectedTotal $0.00
						button.submit-btn#confirmBtn(type="submit")
							i.bx.bx-check
							|  Confirm Collection

			div.card
				h2
					i.bx.bx-list-ul(style="color:#3b82f6")
					|  Current Collections
				div.table-wrapper
					table#collectionsTable
						thead
							tr
								th Order ID
								th Customer
								th Amount
								th Status
								th Date
						tbody#collectionsBody
							tr
								td(colspan="5" class="empty-msg") Select a driver to view collected orders.

			//- NEW: Collection Sessions History
			div.card
				h2
					i.bx.bx-history(style="color:#3b82f6")
					|  Collection Sessions History
				div.table-wrapper
					table#sessionsTable
						thead
							tr
								th Driver Name
								th # Orders
								th Total Amount
								th Date
								th Time
								th Action
						tbody#sessionsBody
							tr
								td(colspan="6" class="empty-msg") No collection sessions recorded yet.

		script.
			window.__SELECTED_DRIVER__ = !{JSON.stringify(selectedDriver || '')};
	script(src="/js/admin.js")
	script(src="/js/collect.js")