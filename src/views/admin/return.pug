extends ../layout

block head
	link(href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet")
	link(rel="stylesheet" href="/css/admin.css")
	link(rel="stylesheet" href="/css/collect.css")
	link(rel="shortcut icon" href="/assets/logogo-removebg-preview.png" type="image/x-icon")

block content
	include ../components/nav/admin-nav.pug
	include ../components/nav/admin-sidebar.pug

	main.main-content
		div.finance-page
			div.page-header
				h1
					i.bx.bx-undo(style="color:#f59e0b")
					|  Return Orders
				p Hand cancelled and exchange goods back to the merchant.

			if success
				div.toast.success Return recorded successfully.
			if error
				div.toast.error= error

			div.card
				h2
					i.bx.bx-plus-circle(style="color:#f59e0b")
					|  Add Return
				div.form-grid
					div.form-field.full
						label Merchant *
						select#merchantSelect(name="merchant" required)
							option(value="") Select Merchant
							- const merchants = pageData && pageData.merchants ? pageData.merchants : [];
							each merchant in merchants
								option(value=merchant.username selected=(selectedMerchant === merchant.username))= (merchant.firstName || '') + ' ' + (merchant.lastName || '')

			div.card
				h2
					i.bx.bx-package(style="color:#f59e0b")
					|  Orders to Return
				div#merchantTypeNote.merchant-type-note

				form#returnForm
					input#merchantUsernameInput(type="hidden" name="merchantUsername" value=selectedMerchant)

					div.scan-row
						button#scanReturnBtn.submit-btn.mobile-only-btn(type="button" style="margin:0; background:#f59e0b;")
							i.bx.bx-scan
							|  Scan
						span.scan-hint Scan a barcode to tick that order in the list below.

					div.table-wrapper
						table
							thead
								tr
									th
										input#selectAllOrders(type="checkbox")
									th Order ID
									th Customer
									th Reason
									th Goods Value ($)
							tbody#ordersBody
								tr
									td(colspan="5" class="empty-msg") Select a merchant to view orders

					div.orders-footer
						div.orders-total
							| Orders Selected:
							span#selectedCount 0
							span.total-divider ·
							| Goods Value Selected:
							span#selectedTotal $0.00
						button.submit-btn#confirmBtn(type="submit")
							i.bx.bx-check
							|  Confirm Return

			div.card
				h2
					i.bx.bx-history(style="color:#f59e0b")
					|  Return Sessions History
				div.table-wrapper
					table#sessionsTable
						thead
							tr
								th Return #
								th Merchant Name
								th Type
								th # Orders
								th Goods Value
								th Date
								th Time
								th Actions
						tbody#sessionsBody
							tr
								td(colspan="8" class="empty-msg") No returns recorded yet.

	//- Barcode scan modal — phones only (see #scanReturnBtn)
	div#returnScanModal.scan-modal
		div.scan-modal-content
			div.scan-modal-header
				h2 Scan Orders to Return
				span.scan-modal-close#closeReturnScanModal &times;
			div.scan-modal-body
				div#returnScanVideoWrap
					video#returnScanVideo(autoplay playsinline muted)
					div#returnScanFlash.scan-flash-overlay
				p#returnScanStatus.scan-status Point the camera at a barcode.
				p.scan-subhint Each scan ticks that order below. Close when you're done, then press Confirm Return.
			div.scan-modal-footer
				button.submit-btn#doneReturnScanBtn(type="button" style="margin:0;") Done

	script.
		window.__INIT_DATA__ = !{initData || '{}'};
		window.__CURRENT_USER__ = !{JSON.stringify(currentUser || null)};
		window.__SELECTED_MERCHANT__ = !{JSON.stringify(selectedMerchant || '')};
	script(src="/js/admin.js")
	script(src="/js/return.js")
