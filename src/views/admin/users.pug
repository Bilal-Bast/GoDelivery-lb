extends ../layout

block head
	link(href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet")
	link(rel="stylesheet" href="/css/admin.css")
	link(rel="stylesheet" href="/css/users.css")
	link(rel="shortcut icon" href="/assets/logogo-removebg-preview.png" type="image/x-icon")

block content
	include ../components/nav/admin-nav.pug
	include ../components/nav/admin-sidebar.pug

	main.main-content
		section.section
			h1.heads 👥 Users Management
			div.primary-container
				div.stats-overview
					div.stat-card
						div.stat-icon.admin
							i.bx.bx-shield
						div.stat-info
							h3 Total Admins
							div.stat-number#totalAdmins 0

					div.stat-card
						div.stat-icon.merchant
							i.bx.bx-store
						div.stat-info
							h3 Total Merchants
							div.stat-number#totalMerchants 0

					div.stat-card
						div.stat-icon.driver
							i.bx.bx-user
						div.stat-info
							h3 Total Drivers
							div.stat-number#totalDrivers 0

				div.form-card
					div.collapsible-header#adminsHeader
						span
							i.bx.bx-shield
							|  Admins
						i.bx.bx-chevron-down#adminsIcon
					div.search-container#adminsSearchContainer(style="display: none")
						input.search-input#adminsSearch(type="text" placeholder="🔍 Search admins by name, username, or phone...")
					div#adminsList.scrollable-list.collapsible-content(style="display: none")
						div.loading-text Loading admins...

				div.form-card
					div.collapsible-header#merchantsHeader
						span
							i.bx.bx-store
							|  Merchants
						i.bx.bx-chevron-down#merchantsIcon
					div.search-container#merchantsSearchContainer(style="display: none")
						input.search-input#merchantsSearch(type="text" placeholder="🔍 Search merchants by name, username, or phone...")
					div#merchantsList.scrollable-list.collapsible-content(style="display: none")
						div.loading-text Loading merchants...

				div.form-card
					div.collapsible-header#driversHeader
						span
							i.bx.bx-user
							|  Drivers
						i.bx.bx-chevron-down#driversIcon
					div.search-container#driversSearchContainer(style="display: none")
						input.search-input#driversSearch(type="text" placeholder="🔍 Search drivers by name, username, or phone...")
					div#driversList.scrollable-list.collapsible-content(style="display: none")
						div.loading-text Loading drivers...

	// ════════════════════════════════════════════════════════════════════════════
	// EDIT USER MODAL
	// ════════════════════════════════════════════════════════════════════════════
	div.modal#editUserModal
		div.modal-content
			div.modal-header
				h2 Edit User
				button.modal-close(type="button")
					i.bx.bx-x
			
			div.modal-body
				div#editMessage.message(style="display: none;")
				
				form#editUserForm
					input#editUserId(type="hidden")

					// Basic Information Section
					fieldset.form-section
						legend Basic Information
						
						div.form-group
							label(for="editUsername")
								span Username
								span.required *
							input#editUsername(
								type="text"
								required
								placeholder="Enter username"
							)

						div.form-row
							div.form-group
								label(for="editFirstName")
									span First Name
									span.required *
								input#editFirstName(
									type="text"
									required
									placeholder="First name"
								)
							
							div.form-group
								label(for="editLastName")
									span Last Name
									span.required *
								input#editLastName(
									type="text"
									required
									placeholder="Last name"
								)

						div.form-group
							label(for="editPhone")
								span Phone
							input#editPhone(
								type="tel"
								placeholder="+1 (555) 000-0000"
							)

					// Merchant-Specific Section
					div#merchantFieldsSection(style="display: none;")
						fieldset.form-section
							legend Merchant Settings
							
							div.form-group
								label(for="editAccountType")
									span Account Type
									span.required *
								select#editAccountType(required)
									option(value="prepaid") Prepaid
									option(value="postpaid") Postpaid

							// Postpaid Fields
							div#postpaidFields(style="display: none;")
								div.form-group
									label(for="editPaymentDay")
										span Payment Day of Month
										span.required *
									input#editPaymentDay(
										type="number"
										min="1"
										max="31"
										placeholder="1-31"
									)

					// Driver-Specific Section
					div#driverFieldsSection(style="display: none;")
						fieldset.form-section
							legend Driver Settings
							
							div.form-group
								label(for="editDriverFee")
									span Delivery Fee
								div.input-group
									span.input-prefix $
									input#editDriverFee(
										type="number"
										min="0"
										step="0.01"
										placeholder="0.00"
									)

					// Password Section
					fieldset.form-section
						legend Change Password
						p.form-hint Leave blank to keep current password
						
						div.form-group
							label(for="editPassword")
								span New Password
							input#editPassword(
								type="password"
								placeholder="Enter new password (optional)"
							)

						div.form-group
							label(for="editConfirmPassword")
								span Confirm Password
							input#editConfirmPassword(
								type="password"
								placeholder="Confirm new password"
							)

					// Action Buttons
					div.modal-actions
						button.btn.btn-cancel(type="button" onclick="document.getElementById('editUserModal').classList.remove('active'); document.body.style.overflow = 'auto';")
							i.bx.bx-x
							span Cancel
						button.btn.btn-primary(type="submit")
							i.bx.bx-check
							span Save Changes

	script.
		window.__INIT_DATA__ = !{initData || '{}'};
		window.__CURRENT_USER__ = !{JSON.stringify(currentUser || null)};
		window.__CSRF_TOKEN__ = !{JSON.stringify(csrfToken || null)};
	script(src="/js/admin.js")
	script(src="/js/users.js")
