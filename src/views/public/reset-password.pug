extends ../layout

block head
	link(rel="stylesheet" href="/css/signin.css")
	link(rel="shortcut icon" href="/assets/logogo-removebg-preview.png" type="image/x-icon")
	style.
		body { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--bg-color, #f1f5f9); }

block content
	div.form-box.login#resetPasswordFormBox
		h2 Set a new password
		form#resetPasswordForm
			div.input-box
				input#newPassword(type="password" placeholder=" " required)
				label(for="newPassword") New password
			p(style="font-size:0.75rem; color: var(--text-secondary); margin-top:-1.25rem; margin-bottom:1.5rem;") At least 8 characters, with upper/lowercase, a number, and a special character (!@#$%^&*)
			div.input-box
				input#confirmPassword(type="password" placeholder=" " required)
				label(for="confirmPassword") Confirm password
			button#resetPasswordSubmit.btn-log(type="submit") Reset password
			p#resetPasswordMessage(style="text-align: center; margin-top: 1rem; font-size: 0.9rem; min-height: 1.2em;")
			p(style="text-align:center; margin-top:1rem;")
				a(href="/signin" style="font-size:0.85rem;") Back to log in

	script(src="/js/reset-password.js")
