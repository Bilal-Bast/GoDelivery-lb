	script(src="https://cdn.tailwindcss.com")
	link(rel="stylesheet" href="/css/signin.css")

	script.
		tailwind.config = {
			theme: {
				extend: {
					fontFamily: {
						sans: ["Inter", "sans-serif"],
						display: ["Outfit", "sans-serif"],
					},
					colors: {
						brand: {
							50: "#f0f9ff",
							100: "#e0f2fe",
							500: "#0ea5e9",
							600: "#0284c7",
							900: "#0c4a6e",
						},
						accent: {
							400: "#38bdf8",
							500: "#f97316",
						},
						dark: "#0f172a",
					},
				},
			},
		};
	link(rel="stylesheet" href="/css/track.css")
	link(rel="shortcut icon" href="/assets/logogo-removebg-preview.png" type="image/x-icon")
	style.
		body { background-color: #fafafa; }
		::-webkit-scrollbar { width: 8px; }
		::-webkit-scrollbar-track { background: #f1f1f1; }
		::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
		::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
		.counter { color: #0ea5e9; }
		.text-gradient { background: linear-gradient(135deg, #0ea5e9, #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
		.reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s cubic-bezier(0.5, 0, 0, 1); }
		.reveal.active { opacity: 1; transform: translateY(0); }
		.blob { position: absolute; filter: blur(80px); z-index: -1; opacity: 0.4; border-radius: 50%; animation: pulse 8s infinite alternate; }
		@keyframes pulse { 0% { transform: scale(1); opacity: 0.3; } 100% { transform: scale(1.2); opacity: 0.5; } }
		.premium-card { transition: all 0.4s ease; background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.5); }
		.premium-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px -15px rgba(14, 165, 233, 0.15); border-color: rgba(14, 165, 233, 0.3); }
		.bg-grid { background-size: 40px 40px; background-image: linear-gradient(to right, rgba(0, 0, 0, 0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(0, 0, 0, 0.03) 1px, transparent 1px); }
		img { max-width: 10%; height: 2rem; }

