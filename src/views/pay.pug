extends layout

block head
	link(href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet")
	link(rel="stylesheet" href="/css/admin.css")
	link(rel="stylesheet" href="/css/collect.css")
	link(rel="shortcut icon" href="/assets/logogo-removebg-preview.png" type="image/x-icon")

block content
	include components/nav/admin-nav.pug
	include components/nav/admin-sidebar.pug

	main.main-content
		div.finance-page
			div.page-header
				h1
					i.bx.bx-money-withdraw(style="color:#10b981")
					|  Pay Merchants
				p Record payments made to merchants for their orders.

			if success
				div.toast.success Payment completed successfully.
			if error
				div.toast.error= error

			div.card
				h2
					i.bx.bx-plus-circle(style="color:#10b981")
					|  Add Payment
				form(method="get" action="/pay")
					div.form-grid
						div.form-field.full
							label Merchant *
							select#merchantSelect(name="merchant" required onchange="this.form.submit()")
								option(value="") Select Merchant
								- const merchants = pageData && pageData.merchants ? pageData.merchants : [];
								each merchant in merchants
									option(value=merchant.username selected=(selectedMerchant === merchant.username))= (merchant.firstName || '') + ' ' + (merchant.lastName || '')
						button.submit-btn(type="submit") Load Orders

			div.card
				h2
					i.bx.bx-package(style="color:#3b82f6")
					|  Merchant Orders
				form#payForm(method="post" action="/pay")
					input(type="hidden" name="merchantUsername" value=selectedMerchant)
					div.table-wrapper
						table
							thead
								tr
									th
										input#selectAllOrders(type="checkbox")
									th Order ID
									th Customer
									th Total ($)
									th Status
							tbody#ordersBody
								- const orders = pageData && pageData.orders ? pageData.orders : [];
								if selectedMerchant && orders.length
									each order in orders
										tr
											td
												input(type="checkbox" name="orderIds" value=order.id onchange="updateSelectedTotal()")
											td= order.id
											td= ((order.c && order.c.f) ? order.c.f : '-') + ' ' + ((order.c && order.c.l) ? order.c.l : '')
											td.amount-cell= (order.pr && order.pr.t) ? order.pr.t : 0
											td Collected
									else
										tr
											td(colspan="5" class="empty-msg") Select a merchant to view orders

					div.orders-footer
						div.orders-total
							| Total Selected: 
							span#selectedTotal $0.00
						button.submit-btn#confirmBtn(type="submit")
							i.bx.bx-check
							|  Confirm Payment

			div.card
				h2
					i.bx.bx-list-ul(style="color:#10b981")
					|  Payments History
				div.table-wrapper
					table#paymentsTable
						thead
							tr
								th #
								th Merchant
								th Created by
								th Amount
								th Date
						tbody#paymentsBody
							- const payments = pageData && pageData.payments ? pageData.payments : [];
							if payments.length
								each payment in payments
									tr
										td= payment.number
										td= payment.merchantName || payment.merchantUsername
										td= payment.adminUsername
										td.amount-cell= '$' + Number(payment.amount).toFixed(2)
										td= new Date(payment.createdAt).toLocaleDateString()
								tr.total-row
									td(colspan="2" style="text-align:right;") Total Paid
									td.amount-cell= '$' + (payments.reduce((sum, item) => sum + Number(item.amount || 0), 0)).toFixed(2)
									td(colspan="2")
							else
								tr
									td(colspan="5" class="empty-msg") No payments recorded yet.

	script.
			window.__INIT_DATA__ = !{initData || '{}'};
		window.__CURRENT_USER__ = !{JSON.stringify(currentUser || null)};
			window.__SELECTED_MERCHANT__ = !{JSON.stringify(selectedMerchant || '')};
	script(src="/js/admin.js")
	script(src="/js/pay.js")
