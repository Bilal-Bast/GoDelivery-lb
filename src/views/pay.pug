extends layout

block head
	link(href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet")
	link(rel="stylesheet" href="/css/admin.css")
	link(rel="shortcut icon" href="/assets/logogo-removebg-preview.png" type="image/x-icon")

block content
	include components/nav/admin-nav.pug
	include components/nav/admin-sidebar.pug

	main.main-content
		div.finance-page
			div.page-header
				h1
					i.bx.bx-money-withdraw(style="color:#10b981")
					|  Pay Merchants
				p Record payments made to merchants for their orders.

			div.card
				h2
					i.bx.bx-plus-circle(style="color:#10b981")
					|  Add Payment
				div.form-grid
					div.form-field
						label Merchant *
						select#merchantSelect
							option(value="") Select Merchant
				div.toast#toast

			div.card
				h2
					i.bx.bx-package(style="color:#3b82f6")
					|  Driver Orders
				div.table-wrapper
					table
						thead
							tr
								th
									input#selectAllOrders(type="checkbox")
								th Order ID
								th Customer
								th Total ($)
								th Status
						tbody#ordersBody
							tr
								td(colspan="5" class="empty-msg") Select a merchant to view orders

				div.orders-footer
					div.orders-total
						| Total Selected: 
						span#selectedTotal $0.00
					button.submit-btn#confirmBtn
						i.bx.bx-check
						|  Confirm Payment

			div.card
				h2
					i.bx.bx-list-ul(style="color:#10b981")
					|  Payments History
				div.table-wrapper
					table#paymentsTable
						thead
							tr
								th #
								th Merchant
								th Created by
								th Amount
								th Date
						tbody#paymentsBody
							tr
								td(colspan="5" class="empty-msg") Loading...

	script(src="/js/admin.js")
	script(src="/js/pay.js")
